# -*- makefile -*-

# Enable VM, USERPROG, and FILESYS features in the kernel
kernel.bin: DEFINES = -DUSERPROG -DFILESYS -DVM

# Directories containing source code
KERNEL_SUBDIRS = threads devices lib lib/kernel userprog filesys vm

# Test directories (VM tests first)
TEST_SUBDIRS = tests/vm tests/userprog tests/filesys/base

# Use the VM grading file
GRADING_FILE = $(SRCDIR)/tests/vm/Grading

# QEMU simulator
SIMULATOR = --qemu

vm_SRC = vm/frame.c vm/page.c
